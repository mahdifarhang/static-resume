{
  "name": "static-resume",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "RESUME_PERSONAL=false NODE_OPTIONS=--openssl-legacy-provider nuxt",
    "dev:personal": "RESUME_PERSONAL=true NODE_OPTIONS=--openssl-legacy-provider nuxt --port 3001",
    "build": "RESUME_PERSONAL=false NODE_OPTIONS=--openssl-legacy-provider nuxt build",
    "build:personal": "RESUME_PERSONAL=true NODE_OPTIONS=--openssl-legacy-provider nuxt build",
    "start": "RESUME_PERSONAL=false NODE_OPTIONS=--openssl-legacy-provider nuxt start",
    "generate": "RESUME_PERSONAL=false NODE_OPTIONS=--openssl-legacy-provider nuxt generate",
    "generate:personal": "RESUME_PERSONAL=true NODE_OPTIONS=--openssl-legacy-provider nuxt generate",
    "lint:js": "eslint --ext \".js,.vue\" --ignore-path .gitignore .",
    "lint": "yarn lint:js",
    "lintfix": "yarn lint:js --fix"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.1.1",
    "@nuxt/cli": "^2.15.8",
    "consola": "^2.15.3",
    "core-js": "^3.19.3",
    "nuxt": "^2.15.8",
    "vue": "^2.6.14",
    "vue-server-renderer": "^2.6.14",
    "vue-template-compiler": "^2.6.14",
    "vuetify": "^2.6.1",
    "webpack": "^4.46.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.16.3",
    "@nuxtjs/eslint-config": "^8.0.0",
    "@nuxtjs/eslint-module": "^3.0.2",
    "@nuxtjs/vuetify": "^1.12.3",
    "eslint": "^8.4.1",
    "eslint-plugin-nuxt": "^3.1.0",
    "eslint-plugin-vue": "^8.2.0"
  },
  "packageManager": "yarn@3.6.1"
}
